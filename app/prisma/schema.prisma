// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ========================================
// Enums
// ========================================

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum AppointmentStatus {
  BOOKED
  COMPLETED
  CANCELLED
  HELD
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
}

enum NotificationType {
  REMINDER
  PRESCRIPTION
  SYSTEM
  NEW_APPOINTMENT
}

enum LLMStatus {
  OK
  FAILED
}

// ========================================
// Users & Auth
// ========================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String   // bcrypt hashed password
  name          String
  role          Role     @default(PATIENT)
  avatarUrl     String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // One-to-one profile relationships
  patientProfile PatientProfile?
  doctorProfile  DoctorProfile?

  // Notifications
  notifications  Notification[]

  // AI Chat history
  aiConversations AIConversation[]

  // Reviews written by this user (patients write reviews)
  reviewsWritten DoctorReview[] @relation("ReviewAuthor")

  @@map("users")
}

// ========================================
// Profiles
// ========================================

model PatientProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  phone     String?
  dob       DateTime?
  gender    String?
  address   String?
  bloodGroup String?
  emergencyContact String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Patient's appointments
  appointments Appointment[]

  @@map("patient_profiles")
}

model DoctorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  specialization  String
  experience      Int      @default(0)   // years of experience
  bio             String?  @db.Text
  education       String?
  location        String?
  slotDurationMin Int      @default(30)

  // Working hours stored as JSON: {"mon": ["09:00","17:00"], "tue": ["09:00","17:00"], ...}
  workingHours    Json?

  // Aggregate rating fields (updated by triggers or application logic)
  rating          Float    @default(0.0)
  totalReviews    Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Doctor's appointments
  appointments    Appointment[]

  // Doctor's leave records
  leaves          DoctorLeave[]

  // Reviews received by this doctor
  reviews         DoctorReview[]

  @@map("doctor_profiles")
}

// ========================================
// Appointments (Core Business Entity)
// ========================================

model Appointment {
  id          String            @id @default(cuid())

  patientId   String
  patient     PatientProfile    @relation(fields: [patientId], references: [id])

  doctorId    String
  doctor      DoctorProfile     @relation(fields: [doctorId], references: [id])

  status      AppointmentStatus @default(BOOKED)
  slotStart   DateTime
  slotEnd     DateTime

  // Optional cancellation reason
  cancelReason String?

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // One-to-one clinical records linked to this appointment
  preVisitSummary  PreVisitSummary?
  postVisitNote    PostVisitNote?

  // Review for this appointment
  review           DoctorReview?

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([slotStart])
  @@map("appointments")
}

// ========================================
// AI-Powered Clinical Records
// ========================================

model PreVisitSummary {
  id                     String       @id @default(cuid())
  appointmentId          String       @unique
  appointment            Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  // Patient's raw symptom input
  rawSymptoms            String       @db.Text

  // AI-generated fields
  urgencyLevel           UrgencyLevel?
  chiefComplaint         String?
  suggestedQuestions     Json?        // String[]
  differentialDiagnosis  Json?        // String[]
  redFlags               Json?        // String[]
  patientFriendlySummary String?      @db.Text

  llmStatus              LLMStatus    @default(OK)

  createdAt              DateTime     @default(now())

  @@map("pre_visit_summaries")
}

model PostVisitNote {
  id                     String       @id @default(cuid())
  appointmentId          String       @unique
  appointment            Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  // Doctor's clinical notes (raw input)
  clinicalNotes          String       @db.Text

  // AI-generated patient-friendly summary
  patientSummary         String?      @db.Text

  // Follow-up
  followUpRecommended    Boolean      @default(false)
  followUpDays           Int?

  llmStatus              LLMStatus    @default(OK)

  createdAt              DateTime     @default(now())

  // Prescriptions linked to this visit
  prescriptions          PrescriptionItem[]

  @@map("post_visit_notes")
}

model PrescriptionItem {
  id              String        @id @default(cuid())
  postVisitNoteId String
  postVisitNote   PostVisitNote @relation(fields: [postVisitNoteId], references: [id], onDelete: Cascade)

  medication      String
  dosage          String
  frequency       String
  durationDays    Int

  @@map("prescription_items")
}

// ========================================
// Doctor Leaves
// ========================================

model DoctorLeave {
  id          String        @id @default(cuid())
  doctorId    String
  doctor      DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  startDate   DateTime
  endDate     DateTime
  reason      String?

  createdAt   DateTime      @default(now())

  @@index([doctorId])
  @@map("doctor_leaves")
}

// ========================================
// Notifications
// ========================================

model Notification {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        NotificationType
  title       String
  message     String           @db.Text
  link        String?
  read        Boolean          @default(false)

  createdAt   DateTime         @default(now())

  @@index([userId])
  @@index([read])
  @@map("notifications")
}

// ========================================
// Doctor Reviews
// ========================================

model DoctorReview {
  id            String        @id @default(cuid())
  doctorId      String
  doctor        DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  // The patient who wrote the review
  authorId      String
  author        User          @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  // Optional link to the specific appointment
  appointmentId String?       @unique
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  rating        Int           // 1-5 stars
  comment       String?       @db.Text

  createdAt     DateTime      @default(now())

  @@index([doctorId])
  @@map("doctor_reviews")
}

// ========================================
// AI Conversations (Chat History)
// ========================================

model AIConversation {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String?
  // Stores array of messages: [{ role: "user"|"assistant", content: "..." }, ...]
  history     Json

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("ai_conversations")
}

// ========================================
// Specializations Lookup
// ========================================

model Specialization {
  id    String @id @default(cuid())
  name  String @unique

  @@map("specializations")
}
